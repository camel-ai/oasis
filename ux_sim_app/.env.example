# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional: model overrides ─────────────────────────────────────────────────
# DEFAULT_MODEL is used for text/persona generation (fast, cheap)
# VISION_MODEL is used for AI redesigns and visual analysis (must support vision)
DEFAULT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o

# ── Optional: Helmholtz LLM endpoint (Qwen3.6 / Qwen3.5 models) ──────────────
# When set, Helmholtz models are tried before OpenAI in the fallback chain.
# Priority: Qwen3.6-35B → Qwen3.6-27B → Qwen3.5-35B → GPT-4o → GPT-4o-mini
HELMHOLTZ_API_KEY=
HELMHOLTZ_BASE_URL=https://helmholtz-blablador.fz-juelich.de:8000/v1

# ── Optional: CloakBrowser (stealth Chromium for CAPTCHA bypass) ──────────────
# CloakBrowser replaces standard Playwright in the pre-flight CAPTCHA guard and
# Mode 2 browser simulations. It uses source-level C++ fingerprint patches to
# pass Cloudflare Turnstile, reCAPTCHA v3, FingerprintJS, and BrowserScan
# without CAPTCHA solving services.
#
# After installing: python -m cloakbrowser install
#
# CLOAKBROWSER_PROXY    — optional HTTP or SOCKS5 proxy
#                         e.g. http://user:pass@proxy:8080
#                              socks5://user:pass@proxy:1080
# CLOAKBROWSER_GEOIP    — auto-detect timezone/locale from proxy exit IP (true/false)
# CLOAKBROWSER_HUMANIZE — enable human-like mouse/keyboard/scroll behavior (true/false)
# CLOAKBROWSER_HUMAN_PRESET — "default" (normal speed) or "careful" (slower)
CLOAKBROWSER_PROXY=
CLOAKBROWSER_GEOIP=false
CLOAKBROWSER_HUMANIZE=true
CLOAKBROWSER_HUMAN_PRESET=default

# ── Optional: CAPTCHA guard ───────────────────────────────────────────────────
# TWOCAPTCHA_API_KEY — last-resort CAPTCHA solver (rarely needed with CloakBrowser)
# CAPTCHA_TIMEOUT    — seconds to wait for a solve before aborting (default 45)
# CAPTCHA_ENABLED    — set to false to skip the pre-flight check entirely
TWOCAPTCHA_API_KEY=
CAPTCHA_TIMEOUT=45
CAPTCHA_ENABLED=true

# ── Optional: Mode 2 Browserbase fallback ─────────────────────────────────────
# Only needed if both CloakBrowser and standard Playwright fail
BROWSERBASE_API_KEY=bb_live_...

# ── Optional: Email delivery ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com

# ── Optional: Performance tuning ─────────────────────────────────────────────
MAX_BROWSER_SESSIONS=3
OASIS_SEMAPHORE=10
